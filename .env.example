# Backend. Never put service account keys in this file.
ANALYTICS_AI_ENVIRONMENT=local
ANALYTICS_AI_REPOSITORY_BACKEND=auto
ANALYTICS_AI_FIREBASE_PROJECT_ID=analytics-ai-dev
ANALYTICS_AI_PLATFORM_PROJECT_ID=analytics-ai-dev
ANALYTICS_AI_CACHE_BUCKET=analytics-ai-dev-dataset-cache
ANALYTICS_AI_CACHE_BACKEND=auto
ANALYTICS_AI_ENABLE_ANALYTICS_TOOLS=false
# Optional browser inference pilot: every UID uses Qwen except explicit Vertex users.
ANALYTICS_AI_ENABLE_BROWSER_QWEN=false
ANALYTICS_AI_ENABLE_BROWSER_AGENT=false
ANALYTICS_AI_VERTEX_USER_IDS=[]
ANALYTICS_AI_ENABLE_ADMIN_CONNECTION_CHECKS=false
ANALYTICS_AI_ENABLE_GA4_USER_OAUTH=false
# Google OAuth 2.0 Web application. Use Secret Manager outside local development.
ANALYTICS_AI_GA4_OAUTH_CLIENT_ID=
ANALYTICS_AI_GA4_OAUTH_CLIENT_SECRET=
ANALYTICS_AI_GA4_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/ga4/callback
ANALYTICS_AI_GA4_OAUTH_RETURN_URL=http://localhost:5174
# Full CryptoKey resource name; the backend stores only KMS ciphertext in Firestore.
ANALYTICS_AI_GA4_OAUTH_KMS_KEY_NAME=
ANALYTICS_AI_ALLOW_INSECURE_DEV_AUTH=false
ANALYTICS_AI_CORS_ORIGINS=["http://localhost:5174"]
ANALYTICS_AI_VERTEX_LOCATION=global
ANALYTICS_AI_VERTEX_MODEL=gemini-3.8-flash
ANALYTICS_AI_ENABLE_BIGQUERY_TOOLS=false
ANALYTICS_AI_BIGQUERY_MAX_DRY_RUN_BYTES=10737418240
ANALYTICS_AI_EXTERNAL_REQUEST_TIMEOUT_SECONDS=180
ANALYTICS_AI_ANALYSIS_TIMEOUT_SECONDS=200
ANALYTICS_AI_GA4_MAX_ATTEMPTS=3
ANALYTICS_AI_GA4_RETRY_BASE_SECONDS=0.25

# Local Firestore override only. Point to the developer user ADC generated by
# `gcloud auth application-default login`; never point to a service account key.
# WSL example:
# GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/mnt/c/Users/your-name/AppData/Roaming/gcloud/application_default_credentials.json
# ANALYTICS_AI_LOCAL_UID=1000
# ANALYTICS_AI_LOCAL_GID=1000

# Frontend public Firebase configuration (identifiers, not credentials).
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=analytics-ai-dev
PUBLIC_FIREBASE_APP_ID=
