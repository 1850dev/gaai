{
  "name": "@analytics-ai/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "echarts": "6.1.0",
    "firebase": "12.18.0",
    "marked": "18.3.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6",
      "re2js": "2.8.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "26.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
